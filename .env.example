# Telegram bot token from @BotFather (required)
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Leave EMPTY only if you really want the bot to be open to everyone.
ALLOWED_USERS=

# Optional. If empty, a key is generated in DATA_DIR/.secret.key (back it up!)
# Generate one with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

#DATA_DIR=data
#MAX_JOBS_PER_USER=5
#MIN_INTERVAL_MINUTES=10
#MAX_PARALLEL_BACKUPS=3
#ALLOW_PRIVATE_IPS=false

# Automatic retry of a failed scheduled backup (RETRY_ATTEMPTS=0 disables it)
#RETRY_ATTEMPTS=3
#RETRY_DELAY_MINUTES=5

# Abuse protection for connection tests (0 disables a limit)
# Comma-separated user IDs exempt from these limits and from the uniform error message
#TRUSTED_USERS=
#TEST_LIMIT_PER_HOUR=10
#TARGET_LIMIT_PER_10MIN=5
#CONN_FAIL_MIN_SECONDS=20
# auto = identical error + timing for every failed test when ALLOWED_USERS is empty
#HIDE_CONN_ERRORS=auto
